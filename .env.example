# =============================================================================
# Autonomous Research Agent — environment template
# Copy to .env and fill what you need.
#
# BUILT TODAY: set at least one of GROQ / OPENAI / OPENROUTER + TAVILY for live runs.
# TARGET (Phase A): empty LLM keys may use OpenCode Zen free open endpoints — not wired yet.
# See docs/PROVIDERS.md · docs/AUDIT.md
# =============================================================================

# ---- LLM (required today for a working research run) -------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
# GROQ_API_KEY_2=                   # optional key pool
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...

# ---- LLM (optional / future presets) ----------------------------------------
# OPENCODE_API_KEY=                 # paid Zen / Go (free Zen models need Phase A)
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=                   # or GOOGLE_API_KEY
# NVIDIA_API_KEY=nvapi-...
# DEEPSEEK_API_KEY=
# CO_API_KEY=                       # Cohere Platform Command API

# Optional base URL overrides
# GROQ_BASE_URL=https://api.groq.com/openai
# OPENAI_BASE_URL=https://api.openai.com
# OPENROUTER_BASE_URL=https://openrouter.ai/api

# ---- Vector store (target Phase B; unused by prototype) ----------------------
# VECTOR_BACKEND=lancedb
# VECTOR_BACKEND=qdrant
# VECTOR_BACKEND=fts
# QDRANT_URL=http://localhost:6333

# ---- Gateway (resilience / cost) ---------------------------------------------
# GATEWAY_MASTER_KEY=
# GATEWAY_MAX_ATTEMPTS=3
# GATEWAY_RETRY_BASE_S=0.5
# GATEWAY_RETRY_CAP_S=8
# GATEWAY_DEFAULT_RPM=60
# GATEWAY_DEFAULT_TPM=120000
# GATEWAY_MAX_PARALLEL=20
# GATEWAY_CIRCUIT_THRESHOLD=5
# GATEWAY_CIRCUIT_COOLDOWN_S=30

# ---- Web search (required for live research) ---------------------------------
TAVILY_API_KEY=tvly_your_tavily_api_key_here
# FIRECRAWL_API_KEY=
# EXA_API_KEY=

# ---- App paths (optional) ----------------------------------------------------
# DATA_DIR=./data
# REPORTS_DIR=./reports
